# 文件名：shturl.cc/UvbjZ
name: ImmortalWrt-25.12-Lucky
on:
  workflow_dispatch: # 手动触发编译

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: 安装依赖
        run: |
          sudo apt update && sudo apt install -y build-essential clang flex bison g++ gawk gcc-multilib g++-multilib \
          gettext git libncurses5-dev libssl-dev python3-distutils rsync unzip zlib1g-dev file wget curl

      - name: 拉取 ImmortalWrt 源码
        run: |
          git clone -b openwrt-25.12 shturl.cc/ITLKBiJ2KbM6Z1Z9puxHJ1QR2LeGOZJBuE9p
          cd immortalwrt
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: 添加 Lucky 软件包
        run: |
          cd immortalwrt/package/lean
          git clone shturl.cc/iqznIKp4dO2y1EfTbIXNSZxZ0
          cd ../../
          # 配置编译选项（选中 Lucky，指定架构，以x86_64为例）
          echo -e "CONFIG_TARGET_x86=y\nCONFIG_TARGET_x86_64=y\nCONFIG_PACKAGE_lucky=y" > .config
          make defconfig

      - name: 编译 Lucky 包
        run: |
          cd immortalwrt
          make package/lucky/compile V=s # 仅编译Lucky包，V=s显示详细日志
